  "components": {
    "schemas": {
      "BrowserState": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "offline",
            "title": "Mode",
            "default": "offline"
          },
          "backend": {
            "type": "string",
            "const": "fake",
            "title": "Backend",
            "default": "fake"
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "CLOSED"
            ],
            "title": "State"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state"
        ],
        "title": "BrowserState"
      },
      "Candidate": {
        "properties": {
          "source": {
            "$ref": "#/components/schemas/SourceIdentity"
          },
          "note_handle": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Note Handle"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "note_type": {
            "type": "string",
            "enum": [
              "normal",
              "video",
              "unknown"
            ],
            "title": "Note Type",
            "default": "unknown"
          },
          "published_at": {
            "type": "null",
            "title": "Published At"
          },
          "summary": {
            "type": "null",
            "title": "Summary"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "note_handle",
          "title"
        ],
        "title": "Candidate"
      },
      "DetailRequest": {
        "properties": {
          "note_handle": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Note Handle"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "note_handle"
        ],
        "title": "DetailRequest"
      },
      "DetailResult": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "offline",
            "title": "Mode",
            "default": "offline"
          },
          "is_synthetic": {
            "type": "boolean",
            "const": true,
            "title": "Is Synthetic",
            "default": true
          },
          "source": {
            "$ref": "#/components/schemas/SourceIdentity"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Body"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "completeness": {
            "type": "string",
            "enum": [
              "FULL_TEXT",
              "PARTIAL_TEXT",
              "SUMMARY_ONLY",
              "METADATA_ONLY"
            ],
            "title": "Completeness"
          },
          "completeness_reason": {
            "type": "string",
            "title": "Completeness Reason"
          },
          "images_read": {
            "type": "boolean",
            "const": false,
            "title": "Images Read",
            "default": false
          },
          "network": {
            "$ref": "#/components/schemas/NetworkSnapshot"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "title",
          "body",
          "summary",
          "completeness",
          "completeness_reason",
          "network"
        ],
        "title": "DetailResult"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/SidecarError"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Health": {
