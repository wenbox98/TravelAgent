          "note_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "不限",
                  "视频",
                  "图文"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Note Type"
          },
          "publish_time": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "不限",
