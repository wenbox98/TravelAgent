# 仅为变量名称参考，不含真实配置或凭证。
# 当前程序只读取进程环境变量，不会自动加载 .env 或本文件。
# 在 Windows 用户环境变量中配置以下三个值，再重新启动运行程序的终端/Codex。

# 服务商提供的 OpenAI 兼容 API 根地址；程序会追加 /chat/completions。
# 不要在这里填写完整的 /chat/completions 请求地址。
LLM_BASE_URL=

# 在本机环境变量中填写真实 API key，不要写入本文件或提交到 Git。
LLM_API_KEY=

# 服务商提供的准确模型 ID；需要支持当前 JSON Schema structured output。
LLM_MODEL=
