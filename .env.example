# 仅为变量名称参考，不含真实配置或凭证。
# 当前程序只读取进程环境变量，不会自动加载 .env 或本文件。
# 在 Windows 用户环境变量中配置以下三个值，再重新启动运行程序的终端/Codex。

# 服务商提供的 OpenAI 兼容 API 根地址；程序会追加 /chat/completions。
# 不要在这里填写完整的 /chat/completions 请求地址。
LLM_BASE_URL=

# 在本机环境变量中填写真实 API key，不要写入本文件或提交到 Git。
LLM_API_KEY=

# 服务商提供的准确模型 ID；需要支持下面选择的 JSON 输出模式。
LLM_MODEL=

# 可选：默认 json_schema；仅支持 JSON Object 的服务显式设为 json_object。
# 两种模式都执行同一份严格本地 schema 和正文定位校验，不自动降级或重试。
LLM_RESPONSE_FORMAT=json_schema
